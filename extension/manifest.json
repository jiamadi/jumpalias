{
  "manifest_version": 3,
  "name": "JumpAlias",
  "version": "2.0.0",
  "description": "Use j + Tab to jump to saved URL paths such as dev github",
  "permissions": [
    "storage",
    "clipboardWrite",
    "tabs",
    "history"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "64": "images/icon64.png",
      "128": "images/icon128.png"
    }
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "windows": "Ctrl+Shift+K",
        "linux": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open JumpAlias"
    }
  },
  "icons": {
    "16": "images/omnibox-transparent16.png",
    "48": "images/icon48.png",
    "64": "images/icon64.png",
    "128": "images/icon128.png"
  },
  "omnibox": {
    "keyword": "j"
  },
  "short_name": "↗"
}
